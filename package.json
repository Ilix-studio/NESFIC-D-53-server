{
  "name": "voicedar-server",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceDAR backend: sync, Assamese ASR + eDAR field mapping, checks, review, export",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "seed": "node scripts/seed.js",
    "asr:benchmark": "node scripts/asr-benchmark.js",
    "fetch-models": "node scripts/fetch-models.js",
    "make-test-audio": "node scripts/make-test-audio.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.cjs"
    ],
    "watchman": false
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "onnxruntime-node": "^1.31.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
